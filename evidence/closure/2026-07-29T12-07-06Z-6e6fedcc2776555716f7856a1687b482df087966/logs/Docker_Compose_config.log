      TELEGRAM_BOT_TOKEN: [REDACTED]
      TELEGRAM_BOT_USERNAME: JawadDevDeskBot
      TELEGRAM_WEBHOOK_SECRET: [REDACTED]
      TRON_API_BASE_URL: https://api.trongrid.io
      TRUSTED_PROXY_HEADER: x-real-ip
