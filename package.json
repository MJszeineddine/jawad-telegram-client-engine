{
  "name": "jawad-telegram-client-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types apps/demo/src/server.ts",
    "dev:bot": "node --env-file-if-exists=.env --experimental-strip-types apps/bot/src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/index.ts",
    "lint": "node --experimental-strip-types scripts/lint.ts",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types tests/e2e/full-flow.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.ts",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "secret:scan": "node --experimental-strip-types scripts/secret-scan.ts",
    "audit:deps": "node --experimental-strip-types scripts/dependency-audit.ts",
    "qa": "npm run lint && npm run typecheck && npm run typecheck:web && npm test && npm run test:integration && npm run test:e2e && npm run build && npm run secret:scan && npm run audit:deps && npm run validate && npm run setup:validate",
    "setup:validate": "node --env-file-if-exists=.env --experimental-strip-types scripts/setup-validator.ts",
    "typecheck:web": "tsc -p tsconfig.web-static.json --noEmit",
    "test:browser": "playwright test",
    "secrets:generate": "node --experimental-strip-types scripts/generate-secrets.ts",
    "db:backup": "node --env-file-if-exists=.env --experimental-strip-types scripts/backup-database.ts",
    "db:restore-test": "node --env-file-if-exists=.env --experimental-strip-types scripts/restore-test.ts",
    "telegram:bootstrap": "node --env-file-if-exists=.env --experimental-strip-types scripts/bootstrap-telegram.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  },
  "type": "module"
}
